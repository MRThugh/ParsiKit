# ParsiKit Configuration Template
# Copy this file to .env or .env.local for local overrides.
# NEVER commit real credentials, API keys, or secrets to version control.

# Application Environment
PARSIKIT_ENV=development

# Optional default VAT rate override (e.g. 0.10 for 10%)
PARSIKIT_DEFAULT_TAX_RATE=0.10

# Optional default currency unit ("toman" or "rial")
PARSIKIT_DEFAULT_CURRENCY=toman

# Optional thread-safe cache toggle ("true" or "false")
PARSIKIT_ENABLE_CACHE=true

# External AI Studio / LLM API key placeholder (for developer documentation tools)
# Replace with your own key from Google AI Studio in local development only
GEMINI_API_KEY=your_gemini_api_key_here
